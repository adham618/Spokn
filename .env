# ─── Spokn build configuration ───────────────────────────────────────────────
# Edit these values before building. They are injected at compile time by Vite.
# NEVER commit secrets here — this file contains only public branding values.

# Ko-fi page URL — change "yourname" to your actual Ko-fi username
VITE_KOFI_URL=https://ko-fi.com/adham_dev

# Extension version shown in the UI (keep in sync with manifest.json + package.json)
VITE_APP_VERSION=1.0.1

# Display name shown in the UI
VITE_APP_NAME=Spokn
